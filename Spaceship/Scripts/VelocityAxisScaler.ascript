// Scales a referenced transform's local scale per axis from the owner's tracked world movement
// along its own local axes (e.g. thruster flames).
component VelocityAxisScaler : Update {
    @field("Target")           transform target;
    @field("Scale X")          bool  scaleX = false;
    @field("Scale Y")          bool  scaleY = false;
    @field("Scale Z")          bool  scaleZ = true;
    // When true, movement along the negative local axis drives the scale instead of the positive.
    @field("Invert Direction") bool  invertDirection = false;
    // Speed along the axis (units/s) at which the scale reaches Max Scale.
    @field("Max Speed")        float maxSpeed = 10.0;
    @field("Min Scale")        float minScale = 0.0;
    @field("Max Scale")        float maxScale = 1.0;
    // Higher is snappier; 0 disables smoothing.
    @field("Smoothness")       float smoothness = 8.0;

    vec3 lastPosition = vec3(0.0, 0.0, 0.0);
    bool hasLastPosition = false;

    fn Drive(current: float, speed: float, dt: float): float {
        let s = speed;
        if (invertDirection) { s = -s; }
        let t = 0.0;
        if (maxSpeed > 0.0) { t = Mathf.clamp01(s / maxSpeed); }
        let desired = Mathf.lerp(minScale, maxScale, t);
        let blend = 1.0;
        if (smoothness > 0.0) { blend = 1.0 - Mathf.exp(-smoothness * dt); }
        return Mathf.lerp(current, desired, blend);
    }

    on Update(dt) {
        if (!target.valid()) { return; }
        if (dt <= 0.0) { return; }

        let tracked = owner.transform;
        let position = tracked.position;
        if (!hasLastPosition) {
            lastPosition = position;
            hasLastPosition = true;
            return;
        }

        let velocity = (position - lastPosition) / dt;
        lastPosition = position;

        // Velocity expressed in the owner's local space.
        let localVelocity = tracked.rotation.inverse * velocity;
        let scale = target.localScale;
        if (scaleX) { scale.x = Drive(scale.x, localVelocity.x, dt); }
        if (scaleY) { scale.y = Drive(scale.y, localVelocity.y, dt); }
        if (scaleZ) { scale.z = Drive(scale.z, localVelocity.z, dt); }
        target.localScale = scale;
    }
}
